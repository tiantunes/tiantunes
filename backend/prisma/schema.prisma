generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FunnelStage {
  NOVO_LEAD
  CONTATO_FEITO
  QUALIFICADO
  PROPOSTA
  FECHADO
  PERDIDO
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

model Lead {
  id             String          @id @default(cuid())
  name           String
  category       String?
  address        String?
  phone          String?
  website        String?
  googleMapsUrl  String?
  rating         Float?
  reviewsCount   Int?
  searchTerm     String
  searchLocation String
  stage          FunnelStage     @default(NOVO_LEAD)
  temperature    LeadTemperature @default(WARM)
  score          Int             @default(0)
  scoreReasons   String[]        @default([])
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  activities     Activity[]

  @@unique([name, address])
  @@index([stage])
  @@index([temperature])
}

/// Singleton row (id always "default") holding the lead-scoring weights used by classifier.ts.
model ClassifierConfig {
  id                          String   @id @default("default")
  noWebsiteScore              Int      @default(40)
  noPhoneScore                Int      @default(5)
  fewReviewsThreshold         Int      @default(10)
  fewReviewsScore             Int      @default(20)
  moderateReviewsThreshold    Int      @default(50)
  moderateReviewsScore        Int      @default(10)
  lowRatingThreshold          Float    @default(3.5)
  lowRatingScore              Int      @default(15)
  highRatingThreshold         Float    @default(4.5)
  highRatingReviewsThreshold  Int      @default(50)
  highRatingScore             Int      @default(10)
  noRatingScore                Int     @default(10)
  hotThreshold                Int      @default(55)
  warmThreshold                Int     @default(30)
  updatedAt                    DateTime @updatedAt
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([leadId])
}
